#table(
    columns: 2,
    inset: 0pt,
    stroke: 1pt,
    align: (center + horizon,center+horizon),
    table.cell(colspan:2,inset:3pt,image({profile.svg}, format: "svg", width: 20cm)),
    table.cell(colspan:1,inset:10pt,image({map.svg}, format: "svg", height: 200pt, width:200pt)),
    table.cell(colspan:1,inset:10pt,image({table.svg}, format: "svg")),
    table.hline()
)


